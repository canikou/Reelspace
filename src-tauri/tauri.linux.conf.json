{
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "resources": {
      "../vendor/ffmpeg/bin/ffmpeg": "vendor/ffmpeg/bin/ffmpeg",
      "../vendor/ffmpeg/bin/ffprobe": "vendor/ffmpeg/bin/ffprobe",
      "../vendor/ffmpeg/LICENSE.txt": "vendor/ffmpeg/LICENSE.txt"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "gstreamer1.0-libav"
        ],
        "section": "video"
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "gstreamer1-plugin-libav"
        ]
      }
    }
  }
}
